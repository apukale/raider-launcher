<?xml version="1.0" encoding="utf-8"?>
<!-- Roboto Flex at weight 300. Baked once per process from @font/roboto_flex, same as Outfit: per-view fontVariationSettings is slow on a TV CPU. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <font
        android:font="@font/roboto_flex"
        android:fontStyle="normal"
        android:fontWeight="300"
        android:fontVariationSettings="'wght' 300"
        tools:targetApi="28" />
</font-family>
