<?xml version="1.0" encoding="utf-8"?>
<!-- Space Grotesk at weight 500. Baked once per process from @font/space_grotesk, same as Outfit: per-view fontVariationSettings is slow on a TV CPU. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <font
        android:font="@font/space_grotesk"
        android:fontStyle="normal"
        android:fontWeight="500"
        android:fontVariationSettings="'wght' 500"
        tools:targetApi="28" />
</font-family>
