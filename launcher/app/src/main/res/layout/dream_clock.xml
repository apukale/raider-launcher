<?xml version="1.0" encoding="utf-8"?>
<!-- Shared screensaver clock and Panchang group. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <View android:id="@+id/dreamAmbient" android:layout_width="match_parent" android:layout_height="match_parent" />
    <ImageView android:id="@+id/dreamPhoto" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" />
    <ImageView android:id="@+id/dreamPhotoNext" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/dream_panel"
        android:padding="30dp"
        android:gravity="top"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                <TextClock android:id="@+id/dreamClock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="h:mm" android:format24Hour="HH:mm" android:textColor="#E6FFFFFF" android:textSize="120sp" android:fontFamily="@font/outfit_extralight" android:letterSpacing="-0.04" android:includeFontPadding="false" />
                <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:gravity="center_vertical" android:format12Hour="a" android:format24Hour="" android:textColor="#99FFFFFF" android:textSize="22sp" android:fontFamily="@font/outfit_medium" android:letterSpacing="0.08" android:includeFontPadding="false" android:textAllCaps="true" />
            </LinearLayout>
            <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginTop="4dp" android:format12Hour="@string/date_format" android:format24Hour="@string/date_format" android:textColor="#8CFFFFFF" android:textSize="18sp" android:fontFamily="@font/outfit_regular" android:letterSpacing="0.14" android:textAllCaps="true" />
        </LinearLayout>

        <View
            android:id="@+id/dreamDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:background="#40FFFFFF" />

        <LinearLayout
            android:id="@+id/calendarBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:id="@+id/calendarWeather" style="@style/DreamCalendarLine" android:visibility="gone" />
            <TextView android:id="@+id/calendarLine1" style="@style/DreamCalendarLine" android:textSize="19sp" android:fontFamily="@font/outfit_medium" />
            <TextView android:id="@+id/calendarTithi" style="@style/DreamCalendarLine" android:layout_marginTop="6dp" />
            <TextView android:id="@+id/calendarNakshatra" style="@style/DreamCalendarLine" android:layout_marginTop="4dp" />
            <TextView android:id="@+id/calendarMoon" style="@style/DreamCalendarLine" android:layout_marginTop="4dp" />
            <TextView android:id="@+id/calendarRahu" style="@style/DreamCalendarLine" android:layout_marginTop="4dp" />
            <TextView android:id="@+id/calendarFestival" style="@style/DreamCalendarLine" android:layout_marginTop="4dp" android:textColor="#FFE4C46A" android:fontFamily="@font/outfit_medium" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/photoCredit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_margin="24dp" android:maxWidth="420dp" android:maxLines="2" android:ellipsize="end" android:padding="8dp" android:background="#99000000" android:textColor="#CCFFFFFF" android:textSize="12sp" android:visibility="gone" />
</FrameLayout>
