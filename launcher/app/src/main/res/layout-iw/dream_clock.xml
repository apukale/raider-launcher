<?xml version="1.0" encoding="utf-8"?>
<!-- Hebrew screensaver: right-aligned clock/date, RTL date text, LTR time numerals. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <View
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView android:id="@+id/dreamPhoto" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" />
    <ImageView android:id="@+id/dreamPhotoNext" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layoutDirection="rtl"
        android:gravity="right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layoutDirection="ltr"
            android:baselineAligned="true">

            <TextClock
                android:id="@+id/dreamAmPm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="#99FFFFFF"
                android:textSize="22sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:letterSpacing="0.08"
                android:textAllCaps="true" />

            <TextClock
                android:id="@+id/dreamClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#E6FFFFFF"
                android:textSize="120sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 200"
                android:letterSpacing="-0.04"
                android:includeFontPadding="false" />
        </LinearLayout>

        <TextClock
            android:id="@+id/dreamDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textDirection="rtl"
            android:gravity="right"
            android:format12Hour="@string/date_format"
            android:format24Hour="@string/date_format"
            android:textColor="#8CFFFFFF"
            android:textSize="18sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 400"
            android:letterSpacing="0.14"
            android:textAllCaps="true" />
        <TextView android:id="@+id/calendarLine1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:textColor="#CCFFFFFF" android:textSize="21sp" />
        <TextView android:id="@+id/calendarLine2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#99FFFFFF" android:textSize="17sp" />
        <TextView android:id="@+id/calendarFestival" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#FFE4C46A" android:textSize="18sp" />
    </LinearLayout>
    <TextView android:id="@+id/photoCredit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|start" android:layout_margin="24dp" android:textColor="#CCFFFFFF" android:textSize="12sp" android:visibility="gone" />
</FrameLayout>
