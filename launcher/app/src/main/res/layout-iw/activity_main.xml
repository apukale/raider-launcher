<?xml version="1.0" encoding="utf-8"?>
<!-- Hebrew-only header positioning. Other languages use layout/activity_main.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Time-of-day backdrop, drawn once a minute (config.xml sky_intensity; 0 keeps it hidden).
         Keep in step with layout/activity_main.xml: every view there must exist here too. -->
    <com.gathin.tvhome.SkyView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Top shelf: the focused dock app's name, positioned above the dock in code. -->
    <TextView
        android:id="@+id/heroName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="68dp"
        android:layout_gravity="right"
        android:gravity="right"
        android:alpha="0"
        android:textColor="#FFFFFFFF"
        android:textSize="48sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 300"
        android:letterSpacing="-0.02"
        android:includeFontPadding="false"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

                        <LinearLayout android:id="@+id/leftBlock" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_toEndOf="@+id/topButtons" android:layout_marginStart="24dp" android:orientation="horizontal" android:gravity="right|center_vertical">
                <LinearLayout android:id="@+id/homeCalendarStack" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/calendar_focus" android:padding="4dp" android:focusable="true" android:clickable="true" android:nextFocusRight="@id/clock" android:clipChildren="false" android:clipToPadding="false">
                    <TextView android:id="@+id/homeCalendarLine1" style="@style/HomeCalendarLine" android:textSize="25sp" android:gravity="right" android:textColor="#F2FFFFFF" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 500" />
                    <TextView android:id="@+id/homeCalendarTithi" style="@style/HomeCalendarLine" android:gravity="right" android:layout_marginTop="1dp" />
                    <TextView android:id="@+id/homeCalendarMoon" style="@style/HomeCalendarLine" android:gravity="right" android:layout_marginTop="1dp" />
                    <TextView android:id="@+id/homeCalendarRahu" style="@style/HomeCalendarLine" android:gravity="right" android:layout_marginTop="1dp" />
                </LinearLayout>
                <View android:id="@+id/homeCalendarDivider" android:layout_width="1dp" android:layout_height="44dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:background="#33FFFFFF" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="right">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:id="@+id/date" android:gravity="right" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="#A6FFFFFF" android:textSize="12sp" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 400" android:letterSpacing="0.14" android:textAllCaps="true" />
                        <TextView android:id="@+id/weather" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:singleLine="true" android:ellipsize="end" android:textColor="#A6FFFFFF" android:textSize="14sp" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 400" android:visibility="gone" />
                    </LinearLayout>
                    <TextView android:id="@+id/greeting" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/shamsiDate" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="true">
                        <TextClock android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="h:mm" android:format24Hour="HH:mm" android:textColor="#FFFFFFFF" android:textSize="52sp" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 300" android:letterSpacing="-0.04" android:includeFontPadding="false" />
                        <TextClock android:id="@+id/ampm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_gravity="bottom" android:layout_marginBottom="8dp" android:format12Hour="a" android:format24Hour="" android:textColor="#B3FFFFFF" android:textSize="15sp" android:fontFamily="@font/outfit" android:fontVariationSettings="'wght' 500" android:letterSpacing="0.08" android:textAllCaps="true" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout><LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignBottom="@id/leftBlock"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopButton"
                    android:text="@string/settings"
                    android:drawableStart="@drawable/ic_settings"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:maxWidth="180dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
